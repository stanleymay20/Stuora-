# Copy to .env.local. These are public client settings, never secrets.
# Development requires a running local Supabase with Stuora migrations applied.
EXPO_PUBLIC_STUORA_ENV=development
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LOCAL_PUBLISHABLE_KEY

# Hosted staging uses mode=staging, a SEPARATE project and its exact HTTPS web origin.
# Production uses mode=production, the controlled Stuora project and approved origin.
# EXPO_PUBLIC_STUORA_WEB_ORIGIN=https://YOUR_APPROVED_HOST
# Never configure EXPO_PUBLIC variables with sb_secret_ or service_role keys.

# Optional features (public switches only; provider keys live in Supabase Edge secrets).
# EXPO_PUBLIC_STUORA_AI_ASSISTANT=enabled      # Bot calls the stuora-assistant function
# EXPO_PUBLIC_STUORA_EXTERNAL_FEEDS=enabled    # partner Jobs/Events from external-data
# EXPO_PUBLIC_STUORA_CITY_LOOKUP=enabled       # "Check city" via OpenStreetMap Nominatim

# Operator details for Imprint / Privacy / Terms (public by law).
# Production builds refuse to run until all are set and LEGAL_REVIEWED=confirmed.
# EXPO_PUBLIC_STUORA_OPERATOR_NAME=
# EXPO_PUBLIC_STUORA_OPERATOR_ADDRESS=
# EXPO_PUBLIC_STUORA_OPERATOR_EMAIL=
# EXPO_PUBLIC_STUORA_OPERATOR_REPRESENTATIVE=
# EXPO_PUBLIC_STUORA_OPERATOR_REGISTER=        # optional, e.g. Amtsgericht Köln HRB …
# EXPO_PUBLIC_STUORA_OPERATOR_VAT_ID=          # optional
# EXPO_PUBLIC_STUORA_PRIVACY_CONTACT=
# EXPO_PUBLIC_STUORA_SUPERVISORY_AUTHORITY=
# EXPO_PUBLIC_STUORA_LEGAL_REVIEWED=confirmed  # only after a lawyer reviewed the texts
