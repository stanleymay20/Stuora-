{
  "expo": {
    "name": "Stuora",
    "slug": "stuora",
    "scheme": "stuora",
    "version": "0.1.6",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Stuora to access photos you choose for student listings.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17152F",
          "image": "./assets/generated-stuora/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stuora.app",
      "icon": "./assets/generated-stuora/icon.png",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.stuora.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/generated-stuora/adaptive-foreground.png",
        "backgroundColor": "#17152F"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/stuora-favicon.png",
      "name": "Stuora",
      "shortName": "Stuora",
      "themeColor": "#17152F"
    },
    "icon": "./assets/generated-stuora/icon.png",
    "owner": "stuora",
    "extra": {
      "eas": {
        "projectId": "1ab07441-9b46-45a3-a5f6-2e33ea5bcf30"
      }
    }
  }
}
