{
  "expo": {
    "name": "Stuora",
    "slug": "stuora",
    "scheme": "stuora",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Stuora to access photos you choose for student listings.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stuora.app"
    },
    "android": {
      "package": "com.stuora.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
