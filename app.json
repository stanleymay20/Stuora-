{
  "expo": {
    "name": "Stuora",
    "slug": "stuora",
    "scheme": "stuora",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Stuora to access photos you choose for student listings.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17152F",
          "image": "./assets/generated-stuora/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/generated-stuora/splash-icon.png",
            "backgroundColor": "#17152F"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stuora.app",
      "icon": "./assets/generated-stuora/icon.png"
    },
    "android": {
      "package": "com.stuora.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/generated-stuora/adaptive-foreground.png",
        "backgroundColor": "#17152F"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/stuora-favicon.png",
      "name": "Stuora",
      "shortName": "Stuora",
      "themeColor": "#17152F"
    },
    "icon": "./assets/generated-stuora/icon.png"
  }
}
