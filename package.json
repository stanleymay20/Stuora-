{
  "name": "stuora",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist",
    "test:database": "node --test tests/database.test.mjs",
    "test:web": "playwright test",
    "check:environment": "node scripts/check-environment.mjs",
    "prestart": "npm run check:environment",
    "preweb": "npm run check:environment",
    "preios": "npm run check:environment",
    "preandroid": "npm run check:environment",
    "preexport:web": "npm run check:environment -- production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.3",
    "expo": "~57.0.31",
    "expo-image-picker": "~57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.0",
    "expo-splash-screen": "~57.0.10"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
